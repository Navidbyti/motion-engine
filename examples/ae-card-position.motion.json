            "fontFamily": "Arial",
            "fontWeight": 400,
            "align": "center"
          },
          "params": {
            "color": "#C8D4E0"
          },
          "sourceRefs": [
            {
              "sourceId": "script",
              "location": "line 3",
              "method": "adapted"
            }
          ]
