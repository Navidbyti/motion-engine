        },
        {
          "id": "beat_subtitle",
          "startFrame": 30,
          "endFrameExclusive": 90,
          "onScreen": [
            {
              "value": "The next line arrives after a pause.",
              "locale": "en-US"
            }
          ],
          "elementIds": [
            "panel",
            "title",
            "subtitle"
          ]
        }
      ],
      "animations": [],
      "sourceRefs": [
        {
          "sourceId": "script",
          "location": "entire file",
          "method": "manual"
        }
      ]
    }
  ],
  "deliverables": [
    {
      "id": "ai",
      "target": "adobe.illustrator",
      "profile": "editable",
      "required": true,
      "editable": true
    }
  ],
  "policies": {
    "qa": [
      {
        "id": "no_overflow",
        "rule": "text.within_safe_area",
        "severity": "error"
      }
    ],
    "disclosures": [],
    "approvals": [
      "final visual"
    ],
    "unsupportedFeature": "error"
  }
