{
  "schemaVersion": "1.0.0",
  "project": {
    "id": "ai-card",
    "title": "Editable Illustrator artboards",
    "locale": "en-US",
    "direction": "ltr"
  },
  "canvas": {
    "width": 1920,
    "height": 1080,
    "frameRate": {
      "numerator": 30,
      "denominator": 1
    },
    "durationFrames": 90,
    "colorSpace": "Rec.709",
    "background": "#101820",
    "safeArea": {
      "top": 80,
      "right": 80,
      "bottom": 80,
      "left": 80
    }
  },
  "sources": [
    {
      "id": "script",
      "uri": "assets/hello-script.md",
      "mediaType": "text/markdown",
      "authority": [
        "text",
        "timing"
      ]
    }
  ],
  "assets": [],
  "datasets": [],
  "timeline": [
    {
      "id": "opening",
      "startFrame": 0,
      "endFrameExclusive": 90,
      "transitionIn": "start",
      "elements": [
        {
          "id": "panel",
          "kind": "shape",
          "startFrame": 0,
          "endFrameExclusive": 90,
          "bounds": {
            "x": 120,
            "y": 200,
            "width": 1680,
            "height": 600
          },
          "params": {
            "shape": "rect",
            "color": "#324B67"
          }
        },
        {
          "id": "title",
          "kind": "text",
          "startFrame": 0,
          "endFrameExclusive": 90,
          "bounds": {
            "x": 160,
            "y": 330,
            "width": 1600,
            "height": 180
          },
          "text": {
            "value": "A small beginning",
            "locale": "en-US",
            "fontFamily": "Arial",
            "fontWeight": 700,
            "align": "left"
          },
          "params": {
            "color": "#FFFFFF"
          },
          "sourceRefs": [
            {
              "sourceId": "script",
              "location": "line 1",
              "method": "manual"
            }
          ]
        },
        {
          "id": "subtitle",
          "kind": "text",
          "startFrame": 0,
          "endFrameExclusive": 90,
          "bounds": {
            "x": 300,
            "y": 590,
            "width": 1320,
            "height": 120
          },
          "text": {
            "value": "The next line arrives after a pause.",
            "locale": "en-US",
            "fontFamily": "Arial",
            "fontWeight": 400,
            "align": "left"
          },
          "params": {
            "color": "#C8D4E0"
          },
          "sourceRefs": [
            {
              "sourceId": "script",
              "location": "line 3",
              "method": "adapted"
            }
          ]
        }
      ],
      "beats": [
        {
          "id": "beat_title",
          "startFrame": 0,
          "endFrameExclusive": 30,
          "onScreen": [
            {
              "value": "A small beginning",
              "locale": "en-US"
            }
          ],
          "elementIds": [
            "panel",
            "title"
