{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:motion-engine:claim-ledger:1",
  "title": "Motion Engine claim evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources", "claims"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sources": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "uri", "sha256", "title", "publisher", "url", "publicationDate", "retrievedDate"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"]},
        "publicationDate": {"type": ["string", "null"]},
        "retrievedDate": {"type": "string"}
      }
    }},
    "claims": {"type": "array", "minItems": 1, "maxItems": 500, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "eventDate", "uncertainty", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "eventDate": {"type": ["string", "null"]},
        "uncertainty": {"type": "string", "maxLength": 2000},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["sourceId", "quote", "relation", "location"],
          "properties": {
            "sourceId": {"$ref": "#/$defs/id"},
            "quote": {"type": "string", "minLength": 1, "maxLength": 2000},
            "relation": {"enum": ["supports", "disputes", "context"]},
            "location": {"type": "string", "minLength": 1}
          }
        }}
      }
    }}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"}}
}
