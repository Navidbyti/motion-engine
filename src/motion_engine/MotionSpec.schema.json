{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:motion-engine:motionspec:1.0.0",
  "title": "MotionSpec 1.0",
  "description": "Portable, source-traceable motion project specification. Subject, language, provider, renderer, and aspect ratio are deliberately open.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "canvas", "sources", "assets", "datasets", "timeline", "deliverables", "policies"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "project": {"type": "object", "additionalProperties": false, "required": ["id", "title", "locale"], "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1}, "locale": {"type": "string", "minLength": 2}, "direction": {"enum": ["ltr", "rtl", "auto"]}, "description": {"type": "string"}, "metadata": {"type": "object"}}},
    "canvas": {"type": "object", "additionalProperties": false, "required": ["width", "height", "frameRate", "durationFrames", "colorSpace"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "frameRate": {"$ref": "#/$defs/rational"}, "durationFrames": {"type": "integer", "minimum": 1}, "colorSpace": {"type": "string", "minLength": 1}, "background": {"$ref": "#/$defs/color"}, "safeArea": {"$ref": "#/$defs/insets"}}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "datasets": {"type": "array", "items": {"$ref": "#/$defs/dataset"}},
    "timeline": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}},
    "deliverables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/deliverable"}},
    "policies": {"$ref": "#/$defs/policies"},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]+$"}, "additionalProperties": {"type": "object"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "rational": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer", "minimum": 1}, "denominator": {"type": "integer", "minimum": 1}}},
    "insets": {"type": "object", "additionalProperties": false, "required": ["top", "right", "bottom", "left"], "properties": {"top": {"type": "number", "minimum": 0}, "right": {"type": "number", "minimum": 0}, "bottom": {"type": "number", "minimum": 0}, "left": {"type": "number", "minimum": 0}}},
    "rect": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "locator": {"type": "object", "additionalProperties": false, "required": ["sourceId", "location"], "properties": {"sourceId": {"$ref": "#/$defs/id"}, "location": {"type": "string", "minLength": 1}, "method": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "uri", "mediaType"], "properties": {"id": {"$ref": "#/$defs/id"}, "uri": {"type": "string", "minLength": 1}, "mediaType": {"type": "string", "minLength": 3}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "authority": {"type": "array", "items": {"type": "string"}}, "license": {"type": "string"}}},
    "asset": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "status"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"type": "string"}, "status": {"enum": ["available", "pending", "optional"]}, "uri": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "provider": {"type": "string"}, "license": {"type": "string"}, "approved": {"type": "boolean"}, "generation": {"type": "object"}, "sourceRefs": {"type": "array", "items": {"$ref": "#/$defs/locator"}}}},
    "column": {"type": "object", "additionalProperties": false, "required": ["name", "type"], "properties": {"name": {"$ref": "#/$defs/id"}, "type": {"enum": ["string", "number", "integer", "boolean", "date", "timecode"]}, "unit": {"type": "string"}, "locale": {"type": "string"}}},
    "dataset": {"type": "object", "additionalProperties": false, "required": ["id", "columns", "rows", "sourceRefs"], "properties": {"id": {"$ref": "#/$defs/id"}, "description": {"type": "string"}, "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/column"}}, "rows": {"type": "array", "items": {"type": "object"}}, "sourceRefs": {"type": "array", "items": {"$ref": "#/$defs/locator"}}, "transform": {"type": "object"}}},
    "text": {"type": "object", "additionalProperties": false, "required": ["value"], "properties": {"value": {"type": "string"}, "locale": {"type": "string"}, "direction": {"enum": ["ltr", "rtl", "auto"]}, "fontFamily": {"type": "string"}, "fontWeight": {"type": "integer", "minimum": 100, "maximum": 900}, "align": {"enum": ["left", "center", "right", "start", "end"]}, "digitPolicy": {"enum": ["locale", "latin", "persian", "arabic_indic", "none"]}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["datasetId", "field"], "properties": {"datasetId": {"$ref": "#/$defs/id"}, "field": {"$ref": "#/$defs/id"}, "filter": {"type": "object"}, "format": {"type": "object"}}},
    "element": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "startFrame", "endFrameExclusive", "params"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"type": "string", "minLength": 1}, "startFrame": {"type": "integer", "minimum": 0}, "endFrameExclusive": {"type": "integer", "minimum": 1}, "bounds": {"$ref": "#/$defs/rect"}, "zIndex": {"type": "integer"}, "text": {"$ref": "#/$defs/text"}, "assetId": {"$ref": "#/$defs/id"}, "dataBinding": {"$ref": "#/$defs/binding"}, "params": {"type": "object"}, "sourceRefs": {"type": "array", "items": {"$ref": "#/$defs/locator"}}, "plugin": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}}}},
    "keyframe": {"type": "object", "additionalProperties": false, "required": ["frame", "value"], "properties": {"frame": {"type": "integer", "minimum": 0}, "value": {}, "easing": {"type": "string"}}},
    "animation": {"type": "object", "additionalProperties": false, "required": ["targetId", "property", "keyframes"], "properties": {"targetId": {"$ref": "#/$defs/id"}, "property": {"type": "string"}, "keyframes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/keyframe"}}}},
    "beat": {"type": "object", "additionalProperties": false, "required": ["id", "startFrame", "endFrameExclusive"], "properties": {"id": {"$ref": "#/$defs/id"}, "startFrame": {"type": "integer", "minimum": 0}, "endFrameExclusive": {"type": "integer", "minimum": 1}, "voice": {"$ref": "#/$defs/text"}, "onScreen": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "elementIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "sourceRefs": {"type": "array", "items": {"$ref": "#/$defs/locator"}}, "notes": {"type": "string"}}},
    "scene": {"type": "object", "additionalProperties": false, "required": ["id", "startFrame", "endFrameExclusive", "elements", "beats", "animations"], "properties": {"id": {"$ref": "#/$defs/id"}, "startFrame": {"type": "integer", "minimum": 0}, "endFrameExclusive": {"type": "integer", "minimum": 1}, "transitionIn": {"type": "string", "enum": ["start", "cut", "fade"]}, "transitionFrames": {"type": "integer", "minimum": 2, "maximum": 120}, "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}}, "beats": {"type": "array", "items": {"$ref": "#/$defs/beat"}}, "animations": {"type": "array", "items": {"$ref": "#/$defs/animation"}}, "sourceRefs": {"type": "array", "items": {"$ref": "#/$defs/locator"}}}},
    "deliverable": {"type": "object", "additionalProperties": false, "required": ["id", "target", "profile", "required", "editable"], "properties": {"id": {"$ref": "#/$defs/id"}, "target": {"type": "string", "minLength": 1}, "profile": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "editable": {"type": "boolean"}, "options": {"type": "object"}}},
    "disclosure": {"type": "object", "additionalProperties": false, "required": ["id", "text", "startFrame", "endFrameExclusive"], "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/text"}, "startFrame": {"type": "integer", "minimum": 0}, "endFrameExclusive": {"type": "integer", "minimum": 1}, "bounds": {"$ref": "#/$defs/rect"}, "sourceRefs": {"type": "array", "items": {"$ref": "#/$defs/locator"}}}},
    "policies": {"type": "object", "additionalProperties": false, "required": ["qa", "disclosures"], "properties": {"qa": {"type": "array", "items": {"type": "object", "required": ["id", "rule", "severity"], "properties": {"id": {"$ref": "#/$defs/id"}, "rule": {"type": "string"}, "severity": {"enum": ["info", "warning", "error"]}, "params": {"type": "object"}}, "additionalProperties": false}}, "disclosures": {"type": "array", "items": {"$ref": "#/$defs/disclosure"}}, "approvals": {"type": "array", "items": {"type": "string"}}, "unsupportedFeature": {"enum": ["error", "warn"]}}}
  }
}
